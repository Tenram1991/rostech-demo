@echo off
title Остановка Rostech Demo
chcp 65001 >nul
echo ===================================================
echo   Остановка сервера разработки...
echo ===================================================

:: Находим процесс, который занимает порт 5173, и принудительно завершаем его
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :5173') do (
    taskkill /F /PID %%a >nul 2>&1
)

echo [OK] Сервер успешно остановлен!
timeout /t 2 >nul