@echo off
title Rostech Demo - Запуск
chcp 65001 >nul
echo ===================================================
echo   Запуск управленческого дашборда закупок...
echo ===================================================

:: 1. Переход в папку проекта
cd /d D:\projects\rostech-demo\client

:: 2. Проверка наличия node_modules (автоустановка при первом запуске)
if not exist "node_modules" (
    echo [!] Папка node_modules не найдена. Устанавливаю зависимости...
    call npm install --legacy-peer-deps
)

:: 3. Освобождение порта 5173 (на случай, если процесс завис в фоне)
echo [*] Проверка и освобождение порта 5173...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :5173') do (
    taskkill /F /PID %%a >nul 2>&1
)
timeout /t 1 /nobreak >nul

:: 4. Открытие браузера (страховка, если Vite не откроет сам)
start "" http://127.0.0.1:5173

:: 5. Запуск Vite
echo [*] Запуск сервера разработки...
echo [*] Приложение откроется в браузере автоматически.
echo [*] Для остановки нажмите Ctrl+C в этом окне.
echo ===================================================
call npm run dev

pause